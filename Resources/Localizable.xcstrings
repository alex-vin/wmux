    "agentRestore.writerLock.changing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex was still updating its session locks, so cmux could not confirm this conversation is free. Retry 'cmux restore --surface'."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex 仍在更新其会话锁，因此 cmux 无法确认此对话未被占用。请重新运行 'cmux restore --surface'。"
          }
        }
      }
    },
    "agentRestore.writerLock.unreadable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux could not read this conversation's Codex session lock, so it could not confirm the conversation is free. Retry 'cmux restore --surface'."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 无法读取此对话的 Codex 会话锁，因此无法确认此对话未被占用。请重新运行 'cmux restore --surface'。"
          }
        }
      }
    },
