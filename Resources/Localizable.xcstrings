    "remoteSession.parked.cleanupBlocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux could not clean up the previous SSH connection to %@. Check that the host is reachable, then use Reconnect to try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 无法清理之前到 %@ 的 SSH 连接。请确认主机可以访问，然后用「重新连接」再试。"
          }
        }
      }
    },
    "remoteSession.parked.notActive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The SSH connection is not active. Use Reconnect to try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 连接未处于活动状态。请用「重新连接」再试。"
          }
        }
      }
    },
    "remoteSession.parked.proxyNotReady": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cmux proxy tunnel to %@ did not become ready. Automatic reconnect paused; use Reconnect to try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到 %@ 的 cmux 代理隧道未能就绪。自动重连已暂停；请用「重新连接」再试。"
          }
        }
      }
    },
    "remoteSession.parked.relayNotReady": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cmux relay on %@ did not become ready (the host may not allow SSH remote port forwarding). Automatic reconnect paused; use Reconnect to try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上的 cmux 中继未能就绪（该主机可能不允许 SSH 远程端口转发）。自动重连已暂停；请用「重新连接」再试。"
          }
        }
      }
    },
