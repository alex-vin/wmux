    "dialog.textURL.rules.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@:// link is asking cmux to paste rules into the current workspace. cmux cannot verify which website or app opened this link.\n\ncmux will paste the rules into the terminal and will not write files or press Return. Only continue if you trust these rules."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:// 链接要求 cmux 将规则粘贴到当前工作区中。 cmux 无法验证哪个网站或应用程序打开了此链接。\n\ncmux 会将规则粘贴到终端中，并且不会写入文件或按 Return。仅当您信任这些规则时才继续。"
          }
        }
      }
    },
