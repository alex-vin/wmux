    },
    "cli.vm.network.invalidProtocol": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "vm network: --protocol takes tcp or udp."
          }
        },
        "zh-Hans": {
