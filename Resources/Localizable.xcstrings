    "coderouter.guide.why.routing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coderouter chooses a healthy team account for each request and moves sessions when another account reaches its limit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Coderouter 会为每个请求选择可用的团队账户，并在另一个账户达到上限时转移会话。"
          }
        }
      }
    },
    "coderouter.guide.why.routing.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
