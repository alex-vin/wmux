    "cli.fork.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage: cmux fork [--surface <id|ref>] <kind> <checkpoint-id>\n       cmux fork <kind> <checkpoint-id> --surface <id|ref>\n       cmux fork --surface=<id|ref> <kind> <checkpoint-id>\n       cmux fork --surface [id|ref]\n\nStart a fork from the saved session on the selected surface."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用法：cmux fork [--surface <id|ref>] <kind> <checkpoint-id>\n      cmux fork <kind> <checkpoint-id> --surface <id|ref>\n      cmux fork --surface=<id|ref> <kind> <checkpoint-id>\n      cmux fork --surface [id|ref]\n\n从所选表面的保存会话启动分叉。"
          }
        }
      }
    },
