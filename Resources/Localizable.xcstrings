          "stringUnit": {
            "state": "translated",
            "value": "tmux was not found on %@. cmux ssh-tmux mirrors a remote tmux server (tmux %@ or newer required).\nInstall it on the host: brew install tmux (macOS), apt install tmux (Debian/Ubuntu), dnf install tmux (Fedora)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@ 上未找到 tmux。cmux ssh-tmux 会镜像远程 tmux 服务器（需要 tmux %@ 或更高版本）。\n在主机上安装它：brew install tmux（macOS）、apt install tmux（Debian/Ubuntu）、dnf install tmux（Fedora）。"
          }
        }
