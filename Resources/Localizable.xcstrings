    "cli.workspaceGroup.help.deleteSafety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dissolve a group, preserving all members"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解散分组，但保留所有成员"
          }
        }
      }
    },
    "cli.workspaceGroup.help.destructiveDelete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete the group AND close every member workspace. Explicitly destructive."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除分组并关闭其中每一个成员工作区。明确的破坏性操作。"
          }
        }
      }
    },
    "cli.workspaceGroup.help.identitySafety": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pass --idempotency-key (or --external-id) to make retries and concurrent creates return one group."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "传入 --idempotency-key（或 --external-id），可让重试与并发创建只返回同一个分组。"
          }
        }
      }
    },
    "cli.workspaceGroup.help.overview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage collapsible workspace groups in the sidebar. Each group is owned by an \"anchor\" workspace; the group header IS the anchor's sidebar representation. Closing the anchor closes only that workspace and promotes the group's next member to be the new anchor, so the group and its other members stay intact. When the anchor is the group's only workspace, the group is removed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理侧边栏中可折叠的工作区分组。每个分组由一个「锚点」工作区拥有；分组标题就是该锚点在侧边栏中的呈现。关闭锚点只会关闭这一个工作区，并把分组中的下一个成员提升为新锚点，因此分组及其他成员保持不变。当锚点是分组中唯一的工作区时，该分组会被移除。"
          }
        }
      }
    },
