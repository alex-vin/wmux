      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can't generate names yet, so cmux uses each session's own agent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 目前无法生成名称，因此 cmux 会使用每个会话自身的代理。"
