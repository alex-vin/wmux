      }
    },
    "settings.app.openSidebarPortLinks.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clicking a port link in the sidebar opens it in the cmux browser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "侧边栏中的端口链接会在 cmux 浏览器中打开。"
          }
        }
      }
    },
    "settings.app.paneFirstClickFocus.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clicking a pane while cmux is in the background focuses that pane right away."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使 cmux 在后台，点按窗格也会立即将焦点移到该窗格。"
          }
        }
      }
    },
    "settings.app.pathLastSegmentOnly.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortens long paths from the start to keep their end visible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长路径会省略开头，保留结尾部分。"
          }
        }
      }
    },
    "settings.app.renameSelectsName.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renaming from the command palette selects the current name."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从命令面板重命名时，会选中当前名称。"
          }
        }
      }
    },
    "settings.app.sidebarBranchLayout.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whether branches share one line or each get their own line."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择分支是共用一行，还是各占一行。"
          }
        }
      }
    },
    "settings.app.stackBranchDirectory.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the branch and directory on separate lines."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分支和目录分行显示。"
          }
        }
      }
    },
    "settings.app.warnBeforeClosingTab.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing a tab asks for confirmation first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭标签页前先要求确认。"
          }
        }
      }
    },
    "settings.app.warnBeforeClosingTabXButton.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clicking a tab's close button asks for confirmation first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按标签页上的关闭按钮后，会先要求确认再关闭。"
          }
        }
      }
    },
    "settings.app.warnBeforeQuit.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose when quitting with Command-Q asks for confirmation. Dirty Only asks only when a workspace would ask before closing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择按 Command + Q 退出时，在什么情况下要求确认。“仅在需要时”只会在某个工作区关闭前需要确认时才询问。"
          }
        }
      }
    },
    "settings.app.workspaceInheritWorkingDirectory.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts new workspaces in the working directory of the current workspace."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新工作区会沿用当前工作区的工作目录。"
          }
        }
      }
    },
    "settings.app.wrapWorkspaceTitles.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows long workspace titles in full on multiple lines."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "较长的工作区标题会换行完整显示。"
          }
        }
      }
    },
    "settings.automation.amp.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows Amp status and notifications in the sidebar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在侧边栏中显示 Amp 的状态和通知。"
          }
        }
      }
    },
    "settings.automation.autoNamingAgent.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic uses each session's own agent. Other supported agents need their command-line tool on the PATH."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动”会使用各会话自身的代理。要使用其他受支持的代理，其命令行工具必须位于 PATH 中。"
          }
        }
      }
    },
    "settings.automation.claudeCode.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows Claude Code status and notifications in the sidebar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在侧边栏中显示 Claude Code 的状态和通知。"
          }
        }
      }
    },
    "settings.automation.codex.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows Codex status and notifications in the sidebar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在侧边栏中显示 Codex 的状态和通知。"
          }
        }
      }
    },
    "settings.automation.cursor.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows Cursor status and notifications in the sidebar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在侧边栏中显示 Cursor 的状态和通知。"
          }
        }
      }
    },
    "settings.automation.gemini.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows Gemini CLI status and notifications in the sidebar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在侧边栏中显示 Gemini CLI 的状态和通知。"
          }
        }
      }
    },
    "settings.automation.kiro.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows Kiro CLI status and notifications in the sidebar, and its tool events in Feed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在侧边栏中显示 Kiro CLI 的状态和通知，并在 Feed 中显示其工具事件。"
          }
        }
      }
    },
    "settings.automation.socketMode.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which local processes can control cmux."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择哪些本地进程可以控制 cmux。"
          }
        }
      }
    },
    "settings.automation.suppressSubagentNotifications.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lists subagent completions in Feed without sending notifications."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "子代理完成时只会列在 Feed 中，不会发送通知。"
          }
        }
      }
    },
    "settings.automation.workspaceAutoNaming.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generates workspace and tab titles from agent conversations."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据代理对话生成工作区和标签页标题。"
          }
        }
      }
    },
    "settings.betaFeatures.cloudMachines.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds Cloud Machines to the right sidebar, Settings, the command palette, and the new workspace menu. Turn this on to enable Cloud work; an administrator can still disable Cloud with a managed policy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在右侧边栏、设置、命令面板和新建工作区菜单中添加云主机。开启此选项即可使用 Cloud；管理员仍可通过受管理政策停用 Cloud。"
          }
        }
      }
    },
    "settings.betaFeatures.customSidebars.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds sidebars from ~/.config/cmux/sidebars to the sidebar picker."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在侧边栏选择器中添加 ~/.config/cmux/sidebars 里的侧边栏。"
          }
        }
      }
    },
    "settings.betaFeatures.extensions.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds the extensions button and lets cmux install and run sidebar extensions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加扩展按钮，并允许 cmux 安装和运行侧边栏扩展。"
          }
        }
      }
    },
    "settings.betaFeatures.feed.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds Feed to the right sidebar for answering agent requests."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在右侧边栏添加 Feed，用于回复代理请求。"
          }
        }
      }
    },
    "settings.betaFeatures.remoteTmux.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows tmux sessions on remote hosts as workspaces in the sidebar. The sessions keep running after cmux quits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在侧边栏中将远程主机上的 tmux 会话显示为工作区。退出 cmux 后，这些会话仍会继续运行。"
          }
        }
      }
    },
    "settings.betaFeatures.workspaceTodoControls.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows Add Checklist Item and status controls on workspaces. A remote rollout can turn them on even while this is off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在工作区上显示“添加清单项”和状态控件。即使关闭此选项，远程推出仍可能启用这些控件。"
          }
        }
      }
    },
    "settings.betaFeatures.workspaceTodosChecklistStyle.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whether clicking a workspace checklist opens a popover or expands it under the row."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择点按工作区清单时，是在浮层中打开，还是在该行下方展开。"
          }
        }
      }
    },
    "settings.browser.enabled.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens browser tabs and links from terminals in the cmux browser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器标签页和从终端打开的链接都会在 cmux 浏览器中打开。"
          }
        }
      }
    },
    "settings.browser.hiddenWebViewDiscard.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frees page memory from hidden browser tabs. Scroll position, form input, and history come back when a tab is shown again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "释放隐藏浏览器标签页的页面内存。标签页再次显示时，会恢复滚动位置、表单输入和浏览历史。"
          }
        }
      }
    },
    "settings.browser.theme.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose light or dark pages for sites that support both. System matches the app appearance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网站同时支持浅色和深色时，选择使用浅色还是深色页面。“系统”会跟随应用外观。"
          }
        }
      }
    },
    "settings.customSidebars.enabled.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds sidebars from ~/.config/cmux/sidebars to the sidebar picker."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在侧边栏选择器中添加 ~/.config/cmux/sidebars 里的侧边栏。"
          }
        }
      }
    },
    "settings.customSidebars.renderer.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Isolated process protects cmux from a faulty sidebar but accepts clicks only. In-app also accepts hover, focus, and typing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“隔离进程”可保护 cmux 不受有问题的侧边栏影响，但只接受点击。“应用内”还接受悬停、聚焦和输入。"
          }
        }
      }
    },
    "settings.globalHotkey.enable.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressing the shortcut in any app shows or hides all cmux windows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意 App 中按下快捷键，即可显示或隐藏所有 cmux 窗口。"
          }
        }
      }
    },
    "settings.mobile.artifactFolderAccess.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how much of a folder iPhone and iPad can browse. One Level shows only the items directly inside it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 iPhone 和 iPad 可浏览文件夹的范围。“一层”只显示该文件夹第一层的项目。"
          }
        }
      }
    },
    "settings.mobile.iOSPairingHost.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets iPhone and iPad pair with and connect to this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 iPhone 和 iPad 与这台 Mac 配对并连接。"
          }
        }
      }
    },
    "settings.mobile.phonePush.forwarding.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends agent notifications from this Mac to cmux on iPhone and iPad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将这台 Mac 上的代理通知发送到 iPhone 和 iPad 上的 cmux。"
          }
        }
      }
    },
    "settings.shortcuts.showModifierHoldHints.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Holding Command or Control shows shortcut hints."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Command 或 Control 键时，会显示快捷键提示。"
          }
        }
      }
    },
    "settings.sidebar.rightMaxWidth.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets the Dock in the right sidebar grow up to this width while leaving room for terminals."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右侧边栏中的 Dock 最宽可扩展到此宽度，同时为终端保留空间。"
          }
        }
      }
    },
    "settings.terminal.adaptiveDefaultTheme.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matches terminal colors to the light or dark appearance when no Ghostty theme or colors are set."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未设置 Ghostty 主题或颜色时，终端颜色会随浅色或深色外观变化。"
          }
        }
      }
    },
    "settings.terminal.agentAutoResume.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reopening cmux resumes agent sessions automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新打开 cmux 时，自动恢复之前的代理会话。"
          }
        }
      }
    },
    "settings.terminal.agentHibernation.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hibernates idle background agent terminals above the live terminal limit. Even when this is off, cmux may hibernate them under memory pressure."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "活动终端超过上限时，空闲的后台代理终端会进入休眠。即使关闭此选项，cmux 仍可能在内存压力达到严重程度时让它们休眠。"
          }
        }
      }
    },
    "settings.terminal.copyOnSelect.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecting text in a terminal copies it to the clipboard."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在终端中选择文本时，会将文本复制到剪贴板。"
