        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：每个换行都作为 Enter 输入；对于大量多行文本，请使用 cmux send --paste 或 cmux paste 以一次粘贴发送"
          }
        }
      }
    },
