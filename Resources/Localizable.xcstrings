    "auth.error.rate_limited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many sign-in requests from this network. cmux retries automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自此网络的登录请求过多。cmux 会自动重试。"
          }
        }
      }
    },
    "account.signIn.error.rateLimited.recovery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux retried automatically. Wait a minute, then try again. Your account and existing cmux workspaces are unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 已自动重试。请等待一分钟后再试。你的账户和现有的 cmux 工作区均未更改。"
          }
        }
      }
    },
    "account.signIn.error.rateLimited.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many sign-in requests from this network"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
