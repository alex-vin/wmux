    "cli.vm.agentUpdates.invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: agent updates must be latest or image."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：代理更新必须为 latest 或 image。"
          }
        }
      }
    },
    "cli.vm.agentUpdates.usage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage:\n  cmux vm agent-updates <id>                 Show the machine's setting.\n  cmux vm agent-updates <id> <latest|image>  Change it.\n\nlatest updates Claude Code, Codex, OpenCode, Pi, and agent-browser to each\ntool's newest GitHub release when you connect, at most once a day, checked\nagainst its sha256 digest. image keeps the versions the machine's image\nbaked (the default). Updates reach only GitHub, which every network mode\nallows. Add --json for the structured result.\nA new release installs only after it has been public for 3 days."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用法：\n  cmux vm agent-updates <id>                 显示机器的设置。\n  cmux vm agent-updates <id> <latest|image>  更改设置。\n\nlatest 会在您连接时（每天最多一次）将 Claude Code、Codex、OpenCode、Pi 和 agent-browser\n更新到各工具最新的 GitHub 发布版本，并校验\n其 sha256 摘要。image 保留机器镜像内置的版本\n（默认）。更新仅访问 GitHub，所有网络模式\n均允许访问。添加 --json 可获得结构化结果。\n新版本须公开发布满 3 天后才会安装。"
          }
        }
      }
    },
    "cli.vm.network.invalidDns": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "vm network: --dns takes on or off."
