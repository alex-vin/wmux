          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用法：cmux restore [--surface <id|ref>] <kind> <checkpoint-id>\n      cmux restore <kind> <checkpoint-id> --surface <id|ref>\n      cmux restore --surface=<id|ref> <kind> <checkpoint-id>"
          }
        }
      }
