    },
    "cloudTree.ports.unsupported.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This provider has no supported in-app port route. Open a shell to access the service inside the machine. Cloud VPN does not add provider support."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此提供商不支持应用内端口路由。请打开 Shell 以在机器内部访问服务。Cloud VPN 不会添加提供商支持。"
          }
        }
      }
    },
