    "cli.help.jumpToLastPrompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage: cmux jump-to-last-prompt\n\nFocus the surface where you last submitted a prompt to a coding agent, switching workspace and window as needed. With --json, opened is false when there is none.\n\nFlags:\n  --json                Print JSON\n  --id-format <mode>    refs, uuids, or both"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用法：cmux jump-to-last-prompt\n\n聚焦你最后一次向编码代理发送提示的界面，必要时切换工作区和窗口。使用 --json 时，若没有则 opened 为 false。\n\n标志:\n  --json                输出 JSON\n  --id-format <mode>    refs、uuids 或 both"
          }
        }
      }
    },
