    "settings.mobile.port.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply saves the port for the next pairing start. Current connections continue. To use the new port, turn iOS Pairing off and on. If the port is unavailable, cmux chooses an available port."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按“应用”会保存端口，在下次启动配对时生效。当前连接会保持。要使用新端口，请关闭再开启 iOS 配对。如果端口不可用，cmux 会选择一个可用端口。"
          }
        }
      }
    },
