    "cli.agentMessage.queued": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queued message %@ for %@ (%@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已将消息 %1$@ 排入 %2$@（%3$@）的队列。"
