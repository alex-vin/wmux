    "cloud.vpn.setup.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional access to each VM's private address and original ports, such as 10.40.0.10:3000."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选设置，用于访问每台 VM 的私有地址和原始端口，例如 10.40.0.10:3000。"
          }
        }
      }
    },
