    "cloudTree.ports.asleep.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wake the machine to check its services. cmux’s in-app forwarding does not need Cloud VPN."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "唤醒机器以检查其服务。cmux 的应用内转发无需 Cloud VPN。"
          }
        }
      }
    },
    "cloudTree.ports.available.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listening services"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "监听中的服务"
          }
        }
      }
    },
    "cloudTree.ports.binding.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux’s browser route connects to 127.0.0.1 on the machine. Bind the service to 127.0.0.1 or 0.0.0.0, then refresh. Turning on Cloud VPN does not change this route."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 的浏览器路由连接到机器上的 127.0.0.1。请将服务绑定到 127.0.0.1 或 0.0.0.0 后刷新。开启 Cloud VPN 不会改变此路由。"
          }
        }
      }
    },
    "cloudTree.ports.binding.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Services use another interface"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务使用其他接口"
          }
        }
      }
    },
    "cloudTree.ports.empty.noService": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a web server on this machine, then refresh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此机器上启动网页服务器，然后刷新。"
          }
        }
      }
    },
    "cloudTree.ports.hub.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build cannot start cmux’s authenticated Cloud forward. Update cmux, then retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本无法启动 cmux 的已验证 Cloud 转发。请更新 cmux 后重试。"
          }
        }
      }
    },
    "cloudTree.ports.link.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Port discovery could not connect to this machine. Existing cmux ports may still work. Refresh to reconnect; Cloud VPN is not required."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口发现无法连接到此机器。现有 cmux 端口可能仍可使用。请刷新以重新连接；无需 Cloud VPN。"
          }
        }
      }
    },
    "cloudTree.ports.link.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud link unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud 连接不可用"
          }
        }
      }
    },
    "cloudTree.ports.loading.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking services through cmux’s authenticated Cloud link. No system VPN is needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在通过 cmux 的已验证 Cloud 连接检查服务。无需系统 VPN。"
          }
        }
      }
    },
    "cloudTree.ports.loopback.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These services open in cmux without Cloud VPN. They listen on the machine’s loopback address, so other apps cannot reach them through its private IP, even with VPN connected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些服务可在 cmux 中打开，无需 Cloud VPN。它们监听机器的回环地址，因此即使已连接 VPN，其他应用也无法通过其专用 IP 访问。"
          }
        }
      }
    },
    "cloudTree.ports.loopback.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopback services available"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回环服务可用"
          }
        }
      }
    },
    "cloudTree.ports.notRequested.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ports not checked yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未检查端口"
          }
        }
      }
    },
    "cloudTree.ports.privateAddress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private address unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "专用地址不可用"
          }
        }
      }
    },
    "cloudTree.ports.privateAddress.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux’s authenticated route needs this machine’s private address. Refresh to retrieve it. Turning on Cloud VPN does not assign a missing address."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 的已验证路由需要此机器的专用地址。请刷新以获取地址。开启 Cloud VPN 不会分配缺失的地址。"
          }
        }
      }
    },
    "cloudTree.ports.routeNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux forwards ports without Cloud VPN. Web browsers and other Mac apps need Cloud VPN to reach services bound to the machine’s private address."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 可转发端口，无需 Cloud VPN。网页浏览器和其他 Mac 应用需要 Cloud VPN，才能访问绑定到机器专用地址的服务。"
          }
        }
      }
    },
    "cloudTree.ports.setupVPN": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set Up VPN…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置 VPN…"
          }
        }
      }
    },
