    "cloud.link.requestTimedOut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Cloud machine did not answer the request before its deadline. The connection will be checked before retrying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud 机器未在截止时间前响应请求。重试前将检查连接。"
          }
        }
      }
    },
    "cloud.welcome.note.teamAvailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud can be enabled through your team; machine access follows the team’s plan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可通过您的团队启用 Cloud；机器访问权限取决于团队方案。"
          }
        }
      }
    },
    "cloud.welcome.note.teamIncluded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Included through your team’s plan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已包含在您团队的方案中。"
          }
        }
      }
    },
    "cli.restore.error.conversationNotFound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: this session has no saved conversation to resume. Start the agent again in this terminal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "restore: 此会话没有可恢复的已保存对话。请在此终端中重新启动代理。"
          }
        }
      }
    },
    "cloud.operation.failure.capacity": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your team's running machines are using all of the plan's Cloud capacity. Pause or delete a running machine, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您团队中正在运行的机器已用尽套餐的全部 Cloud 容量。请暂停或删除一台正在运行的机器，然后重试。"
          }
        }
      }
    },
    "cloud.operation.failure.activeLimit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every active machine your plan allows is in use. Pause or delete a running machine, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的套餐允许的所有活跃机器都已在使用。请暂停或删除一台正在运行的机器，然后重试。"
          }
        }
      }
    },
    "cloud.operation.failure.createCredits": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your team has no machine create credits left. Ask a team admin to add credits or upgrade the plan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的团队已没有创建机器的额度。请让团队管理员添加额度，或升级套餐。"
          }
        }
      }
    },
    "cloud.operation.failure.memoryRequiresPlan": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This size is larger than your plan includes. Choose a smaller size, or upgrade the plan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此规格超出您的套餐所含范围。请选择较小的规格，或升级套餐。"
          }
        }
      }
    },
    "cloud.operation.failure.createCredits.account": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account has no machine create credits left. Add Cloud VM create credits or upgrade your plan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的帐户已没有创建机器的额度。请添加 Cloud VM 额度或升级套餐。"
          }
        }
      }
    },
    "cli.vm.restart.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request recovery when supported. Running processes may be lost."
