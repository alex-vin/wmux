    "settings.mobile.browserTunnel.allowOtherHosts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS Browser Reaches Other Hosts"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 浏览器可访问其他主机"
          }
        }
      }
    },
    "settings.mobile.browserTunnel.allowOtherHosts.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iOS browser can load LAN, VPN, and internet hosts through this Mac. Link-local and cloud metadata addresses never go through this Mac; the phone loads them itself."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 浏览器可通过这台 Mac 加载局域网、VPN 和互联网主机。链路本地地址和云元数据地址绝不经过这台 Mac，由 iPhone 自行加载。"
          }
        }
      }
    },
    "settings.mobile.browserTunnel.allowOtherHosts.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iOS browser reaches only this Mac's localhost through this Mac. Other sites load over the phone's own network."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 浏览器只会通过这台 Mac 访问它的 localhost。其他网站通过手机自身的网络加载。"
          }
        }
      }
    },
    "settings.search.alias.setting.mobile.browserTunnelAllowOtherHosts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "mobile ios iphone browser on iphone tunnel proxy localhost lan vpn internet hosts network security"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "mobile ios iphone browser on iphone tunnel proxy localhost lan vpn internet hosts network security 移动 浏览器 隧道 代理 局域网 主机 网络 安全"
          }
        }
      }
    },
    "cli.browser.inputFiles.error.usage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "set-input-files requires --selector <css> and either --file <path> (repeatable) or --clear"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "set-input-files 需要 --selector <css>，以及 --file <path>（可重复）或 --clear"
