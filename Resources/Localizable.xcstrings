    "dialog.saveWorkspaceLayout.commandTooLongMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "One or more captured commands are longer than %lld UTF-8 byte and cannot be replayed reliably from a saved layout. Shorten them before saving."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "One or more captured commands are longer than %lld UTF-8 bytes and cannot be replayed reliably from a saved layout. Shorten them before saving."
