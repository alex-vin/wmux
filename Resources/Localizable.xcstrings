    "cli.send.error.draftPresent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: the agent prompt in %2$@ holds text someone is typing, so nothing was sent. Retry when the prompt is clear, or pass --force to send anyway."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：%2$@ 中的代理提示里有人正在输入文本，因此未发送任何内容。请在提示清空后重试，或传入 --force 强制发送。"
          }
        }
      }
    },
