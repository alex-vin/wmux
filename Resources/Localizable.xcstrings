      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light agents and quick tasks"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻量代理与快速任务"
          }
        }
      }
    },
    "pricing.native.sizes.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro includes up to 5 Cloud VMs sharing 20 vCPUs and 40 GB RAM. One VM can use up to 16 GB RAM / 8 vCPU; the 24 GB / 12 vCPU and 32 GB / 16 vCPU sizes require Max. Team adds the same pool for each paid seat, shared across the team. Your VMs draw from one pool. Run one large VM or five small ones. Paused VMs do not use the pool. There is no metering or overage billing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro 最多包含 5 台云端虚拟机，共享 20 个虚拟 CPU 和 40 GB 内存。Team 为每个付费席位增加相同的资源池，由整个团队共享。你的虚拟机共用一个资源池，可以运行一台大型虚拟机，也可以运行五台小型虚拟机。已暂停的虚拟机不占用资源池。不按用量计费，也不收取超额费用。 单台 VM 最多可使用 16 GB 内存 / 8 vCPU。24 GB / 12 vCPU 和 32 GB / 16 vCPU 规格需要 Max。"
          }
        }
      }
    },
