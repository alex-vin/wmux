    "taskManager.killProcess.message.one": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask %@ (PID %lld) to terminate gracefully. cmux will force-kill it if it is still running after a short grace period."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求 %@（PID %lld）正常退出。若短暂宽限期后仍在运行，cmux 会强制结束它。"
          }
        }
      }
    },
    "taskManager.killProcess.message.other": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ask %lld process to terminate gracefully. cmux will force-kill remaining processes after a short grace period. PID: %@."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ask %lld processes to terminate gracefully. cmux will force-kill remaining processes after a short grace period. PIDs: %@."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "请求 %lld 个进程正常终止。在短暂的宽限期后，cmux 将强制结束剩余进程。PID：%@。"
                }
              }
            }
          }
        }
      }
    },
