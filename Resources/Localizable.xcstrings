          "stringUnit": {
            "state": "translated",
            "value": "SSH 控制套接字路径对于 Unix 域套接字而言过长（%lld > %#@count2@）；主目录路径过长"
          },
          "substitutions": {
            "count2": {
              "argNum": 2,
              "formatSpecifier": "lld",
