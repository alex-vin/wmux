    "update.error.installRecovery.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move cmux into Applications and relaunch to enable updates. If it’s already in Applications, restart your Mac and try again, or download the latest version below."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将 cmux 移到「应用程序」文件夹中，然后重新启动以启用更新。如果它已在「应用程序」中，请重启 Mac 后重试，或在下方下载最新版本。"
          }
        }
      }
    },
    "update.error.installerAgent.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS didn’t start cmux’s updater helper in time. Security software can delay it. Retry once; if it still fails, restart your Mac or download and install the latest version below."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 未能及时启动 cmux 的更新助手。安全软件可能会延迟其启动。请重试一次；如果仍然失败，请重新启动 Mac，或在下方下载并安装最新版本。"
          }
        }
      }
    },
