    "settings.app.openSidebarPRLinks.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clicking a pull request link in the sidebar opens it in the cmux browser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "侧边栏中的 PR 链接会在 cmux 浏览器中打开。"
          }
