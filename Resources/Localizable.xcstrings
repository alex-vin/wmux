    "surfaceDrop.cloudMachineMismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud workspaces can only hold terminals and displays from their own Cloud machine. Browser tabs can move freely. Open a local workspace to move other splits there."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud 工作区只能包含来自同一台 Cloud 机器的终端和显示器。浏览器标签页可以自由移动。打开本地工作区以移入其他分屏。"
          }
        }
      }
    },
    "surfaceCatalog.error.ambiguousRemotePlacement": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This terminal has more than one remote placement. Specify the remote tab."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此终端有多个远程位置。请指定远程标签页。"
          }
        }
      }
    },
    "cloudTree.error.renameTerminalNoView": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This terminal is not open in a remote workspace."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此终端未在任何远程工作区中打开。"
          }
        }
      }
    },
    "cloudTree.error.renameTerminalPartial": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal rename changed %1$d of %#@count2@. Another change prevented a safe rollback. Refresh and retry."
          },
          "substitutions": {
            "count2": {
              "argNum": 2,
              "formatSpecifier": "d",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%d remote tab"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%d remote tabs"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端重命名更改了其中的 %1$d 个（共 %#@count2@）。另一项更改阻止了安全回滚。请刷新并重试。"
          },
          "substitutions": {
            "count2": {
              "argNum": 2,
              "formatSpecifier": "d",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%d 个远程标签页"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "cloudTree.error.renameTerminalResponse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remote rename response was invalid. Refresh and retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程重命名的响应无效。请刷新后重试。"
          }
        }
      }
    },
    "cloudTree.error.renameTerminalGeneration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remote rename came from a different VM session. Refresh and retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此次远程重命名来自另一个 VM 会话。请刷新后重试。"
          }
        }
      }
    },
    "cloudTree.error.renameTerminalRevision": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remote rename returned revision %2$llu after revision %1$llu. Refresh and retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程重命名返回了修订号 %2$llu（在修订号 %1$llu 之后）。请刷新并重试。"
          }
        }
      }
    },
    "cloudTree.error.renameWorkspaceEmptyName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A workspace name cannot be empty."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作区名称不能为空。"
          }
        }
      }
    },
    "cloudTree.error.remoteWorkspaceNotFound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote workspace %@ is no longer available. Refresh and retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程工作区 %@ 已不可用。请刷新后重试。"
          }
        }
      }
    },
    "cloudTree.error.remotePlacementUnavailable": {
