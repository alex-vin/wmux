#!/usr/bin/env bash
# wmux-subagent: Coordinated subagent pane launcher for wmux
# Launches a subtask in a dedicated split pane with account isolation and git worktree support.

set -euo pipefail

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
CMUX_CONFIG_ROOT="${REAL_USER_HOME:-$HOME}/.config/cmux"
SUBAGENTS_DIR="$CMUX_CONFIG_ROOT/subagents"
STATUS_JSON=""
START_TIME=""

show_help() {
    cat <<'EOF'
Usage:
  wmux-subagent run --title <title> --prompt <prompt> [--account <id>] [--worktree] [--wait]
  wmux-subagent report [--latest | --list | <task-id>]
  wmux-subagent help | --help | -h

Commands:
  run                     Launch a subagent in a coordinated pane
  report                  View or list subagent conclusion reports (.wmux/reports)

Options:
  --title <title>         Brief name or role of the subtask (required)
  --prompt <prompt>       Instructions / prompt for the subagent (required)
  --account <id>          Explicit Gemini account ID (default: auto from pool)
  --worktree              Run in an isolated git worktree (.wmux/worktrees/<task-id>)
  --wait                  Wait for subtask completion, retrieve output, and print to stdout
  -h, --help              Show this help message

Examples:
  wmux-subagent run --title "Code Review" --prompt "Review recent changes in auth module"
  wmux-subagent run --title "Bugfix" --prompt "Fix null pointer in parser" --worktree --wait
  wmux-subagent report --latest
  wmux-subagent report --list
EOF
}

resolve_cmux_bin() {
    local candidate
    candidate="${CMUX_BUNDLED_CLI_PATH:-}"
    if [[ -n "$candidate" && -x "$candidate" ]]; then
        printf '%s' "$candidate"
        return 0
    fi

    candidate="$SELF_DIR/cmux"
    if [[ -x "$candidate" ]]; then
        printf '%s' "$candidate"
        return 0
    fi

    candidate="$(command -v cmux || true)"
    if [[ -n "$candidate" ]]; then
        printf '%s' "$candidate"
        return 0
    fi

    # Check common derived data locations
    local dev_candidate="/Users/wenxinwu/Library/Developer/Xcode/DerivedData/cmux-dev/Build/Products/Debug/cmux"
    if [[ -x "$dev_candidate" ]]; then
        printf '%s' "$dev_candidate"
        return 0
    fi

    return 1
}

resolve_agy_bin() {
    if [[ -x "$SELF_DIR/agy" ]]; then
        printf '%s' "$SELF_DIR/agy"
        return 0
    fi

    local candidate
    candidate="$(command -v agy || true)"
    if [[ -n "$candidate" && -x "$candidate" ]]; then
        printf '%s' "$candidate"
        return 0
    fi

    printf 'agy'
    return 0
}

resolve_account_id() {
    local explicit="${1:-}"
    if [[ -n "$explicit" ]]; then
        printf '%s' "$explicit"
        return 0
    fi

    local surface_id="${2:-}"
    local tokens_dir="$CMUX_CONFIG_ROOT/gemini_tokens"

    # 1. Match surface UUID directly in gemini_tokens/<uuid>.env
    if [[ -n "$surface_id" && -d "$tokens_dir" ]]; then
        local env_file="$tokens_dir/${surface_id}.env"
        local retries=30
        while (( retries > 0 )) && [[ ! -f "$env_file" ]]; do
            sleep 0.05
            (( retries-- ))
        done
        if [[ -f "$env_file" ]]; then
            local acc
            acc="$(sed -n 's/.*CMUX_AGY_ISOLATED_ACCOUNT="\{0,1\}\([^" ]*\).*/\1/p' "$env_file" | head -n 1 || true)"
            if [[ -n "$acc" ]]; then
                printf '%s' "$acc"
                return 0
            fi
        fi
    fi

    # Fallback to pool label (never blindly pick stale ls -t *.env)
    printf 'pool'
    return 0
}

write_status_json() {
    local file="$1"
    local id="$2"
    local title="$3"
    local account="$4"
    local surface_id="$5"
    local status="$6"
    local start_time="$7"

    if command -v python3 >/dev/null 2>&1; then
        python3 -c '
import json, sys
data = {
    "id": sys.argv[1],
    "title": sys.argv[2],
    "account": sys.argv[3],
    "surface_id": sys.argv[4],
    "status": sys.argv[5],
    "start_time": int(sys.argv[6])
}
with open(sys.argv[7], "w") as f:
    json.dump(data, f, indent=2)
' "$id" "$title" "$account" "$surface_id" "$status" "$start_time" "$file" 2>/dev/null || {
        cat <<EOF > "$file"
{
  "id": "$id",
  "title": "$title",
  "account": "$account",
  "surface_id": "$surface_id",
  "status": "$status",
  "start_time": $start_time
}
EOF
    }
    else
        cat <<EOF > "$file"
{
  "id": "$id",
  "title": "$title",
  "account": "$account",
  "surface_id": "$surface_id",
  "status": "$status",
  "start_time": $start_time
}
EOF
    fi
}

extract_surface_uuid() {
    local json_text="$1"
    local sid=""

    if command -v python3 >/dev/null 2>&1; then
        sid="$(python3 -c '
import sys, json
try:
    data = json.loads(sys.stdin.read())
    print(data.get("surface_id") or "")
except Exception:
    pass
' <<< "$json_text" 2>/dev/null || true)"
    fi

    if [[ -z "$sid" ]]; then
        sid="$(printf '%s' "$json_text" | sed -E -n 's/.*"surface_id"[[:space:]]*:[[:space:]]*"([0-9a-fA-F-]+)".*/\1/p' | head -n 1 || true)"
    fi

    printf '%s' "$sid"
}

extract_surface_ref() {
    local json_text="$1"
    local sref=""

    if command -v python3 >/dev/null 2>&1; then
        sref="$(python3 -c '
import sys, json
try:
    data = json.loads(sys.stdin.read())
    print(data.get("surface_ref") or data.get("surface_id") or "")
except Exception:
    pass
' <<< "$json_text" 2>/dev/null || true)"
    fi

    if [[ -z "$sref" ]]; then
        sref="$(printf '%s' "$json_text" | grep -oE 'surface:[0-9a-zA-Z-]+' | head -n 1 || true)"
    fi

    printf '%s' "$sref"
}

extract_surface_id() {
    extract_surface_ref "$@"
}

extract_pane_ref() {
    local json_text="$1"
    local pref=""

    if command -v python3 >/dev/null 2>&1; then
        pref="$(python3 -c '
import sys, json
try:
    data = json.loads(sys.stdin.read())
    print(data.get("pane_ref") or data.get("pane_id") or "")
except Exception:
    pass
' <<< "$json_text" 2>/dev/null || true)"
    fi

    if [[ -z "$pref" ]]; then
        pref="$(printf '%s' "$json_text" | grep -oE 'pane:[0-9a-zA-Z-]+' | head -n 1 || true)"
    fi

    printf '%s' "$pref"
}

extract_workspace_ref() {
    local json_text="$1"
    local wid=""

    if command -v python3 >/dev/null 2>&1; then
        wid="$(python3 -c '
import sys, json, re
text = sys.stdin.read()
try:
    data = json.loads(text)
    print(data.get("workspace_ref") or data.get("workspace_id") or "")
except Exception:
    m = re.search(r"\"workspace_(?:ref|id)\"\s*:\s*\"([^\"]+)\"", text)
    print(m.group(1) if m else "")
' <<< "$json_text" 2>/dev/null || true)"
    fi

    if [[ -z "$wid" ]]; then
        wid="$(printf '%s' "$json_text" | sed -E -n 's/.*"workspace_(ref|id)"[[:space:]]*:[[:space:]]*"([^"]*)".*/\2/p' | head -n 1 || true)"
    fi

    if [[ -z "$wid" ]]; then
        wid="$(printf '%s' "$json_text" | grep -oE 'workspace:[0-9a-zA-Z-]+' | head -n 1 || true)"
    fi

    printf '%s' "$wid"
}

CLEANUP_STATUS_JSON=""
CLEANUP_STATE_DIR=""
CLEANUP_WORKTREE_DIR=""
CLEANUP_REPO_ROOT=""
CLEANUP_BRANCH_NAME=""

cleanup_on_exit() {
    local exit_code=$?
    trap - EXIT ERR INT TERM

    # 1. Clean up status file if interrupted or failed unexpectedly
    if [[ -n "${CLEANUP_STATUS_JSON:-}" && -f "$CLEANUP_STATUS_JSON" ]]; then
        if [[ $exit_code -ne 0 ]]; then
            rm -f "$CLEANUP_STATUS_JSON"
        fi
    fi

    # 2. Clean up git worktree if aborted
    if [[ $exit_code -ne 0 && -n "${CLEANUP_WORKTREE_DIR:-}" && -d "$CLEANUP_WORKTREE_DIR" ]]; then
        if [[ -n "${CLEANUP_REPO_ROOT:-}" ]]; then
            git -C "$CLEANUP_REPO_ROOT" worktree remove --force "$CLEANUP_WORKTREE_DIR" >/dev/null 2>&1 || true
            if [[ -n "${CLEANUP_BRANCH_NAME:-}" ]]; then
                git -C "$CLEANUP_REPO_ROOT" branch -D "$CLEANUP_BRANCH_NAME" >/dev/null 2>&1 || true
            fi
        fi
    fi

    # 3. Clean up temporary state directory unless debug mode
    # In async mode (WAIT=0, exit_code=0), runner.sh inside the pane will clean up when finished
    if [[ -z "${WMUX_DEBUG:-}" && -n "${CLEANUP_STATE_DIR:-}" && -d "$CLEANUP_STATE_DIR" ]]; then
        if [[ $exit_code -ne 0 || "${WAIT:-0}" == "1" ]]; then
            rm -rf "$CLEANUP_STATE_DIR"
        fi
    fi

    exit "$exit_code"
}
trap cleanup_on_exit EXIT ERR
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

cmd_run() {
    local TITLE=""
    local PROMPT=""
    local ACCOUNT=""
    local WORKTREE=0
    local WAIT=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --title)
                [[ $# -ge 2 ]] || { echo "Error: --title requires an argument" >&2; exit 1; }
                TITLE="$2"
                shift 2
                ;;
            --title=*)
                TITLE="${1#*=}"
                shift
                ;;
            --prompt)
                [[ $# -ge 2 ]] || { echo "Error: --prompt requires an argument" >&2; exit 1; }
                PROMPT="$2"
                shift 2
                ;;
            --prompt=*)
                PROMPT="${1#*=}"
                shift
                ;;
            --account)
                [[ $# -ge 2 ]] || { echo "Error: --account requires an argument" >&2; exit 1; }
                ACCOUNT="$2"
                shift 2
                ;;
            --account=*)
                ACCOUNT="${1#*=}"
                shift
                ;;
            --worktree)
                WORKTREE=1
                shift
                ;;
            --wait)
                WAIT=1
                shift
                ;;
            -h|--help)
                show_help
                exit 0
                ;;
            *)
                echo "Error: Unknown option '$1'. Use --help for usage." >&2
                exit 1
                ;;
        esac
    done

    if [[ -z "$TITLE" ]]; then
        echo "Error: --title <title> is required." >&2
        exit 1
    fi

    if [[ -z "$PROMPT" ]]; then
        echo "Error: --prompt <prompt> is required." >&2
        exit 1
    fi

    local CMUX_BIN
    CMUX_BIN="$(resolve_cmux_bin || true)"
    if [[ -z "$CMUX_BIN" ]]; then
        echo "Error: cmux CLI binary could not be found." >&2
        exit 1
    fi

    local AGY_BIN
    AGY_BIN="$(resolve_agy_bin)"

    cmux_invoke() {
        if [[ -n "${CMUX_SOCKET_PATH:-}" ]]; then
            "$CMUX_BIN" --socket "$CMUX_SOCKET_PATH" "$@"
        else
            "$CMUX_BIN" "$@"
        fi
    }

    # Verify cmux socket connectivity
    if ! cmux_invoke ping >/dev/null 2>&1; then
        echo "Error: Cannot connect to wmux/cmux control socket." >&2
        if [[ -n "${CMUX_SOCKET_PATH:-}" ]]; then
            echo "CMUX_SOCKET_PATH='$CMUX_SOCKET_PATH' is unreachable." >&2
        else
            echo "CMUX_SOCKET_PATH is not set and default socket is not active." >&2
        fi
        exit 1
    fi

    # Generate unique, safe task ID
    local TITLE_SLUG
    TITLE_SLUG="$(printf '%s' "$TITLE" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed -E 's/^-+|-+$//g' | cut -c1-20)"
    local RANDOM_SUFFIX
    RANDOM_SUFFIX="$(od -An -N3 -tx /dev/urandom 2>/dev/null | tr -d ' ' || echo "$RANDOM")"
    local TASK_ID
    if [[ -n "$TITLE_SLUG" ]]; then
        TASK_ID="${TITLE_SLUG}-$(date +%s)-${RANDOM_SUFFIX:0:6}"
    else
        TASK_ID="subtask-$(date +%s)-${RANDOM_SUFFIX:0:6}"
    fi

    # Setup git worktree if requested
    local REPO_ROOT=""
    local WORKTREE_DIR=""
    local BRANCH_NAME=""
    local TARGET_DIR="$PWD"

    if [[ "$WORKTREE" == "1" ]]; then
        if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            echo "Error: --worktree requested, but current directory is not a git repository." >&2
            exit 1
        fi
        REPO_ROOT="$(git rev-parse --show-toplevel)"
        WORKTREE_DIR="$REPO_ROOT/.wmux/worktrees/$TASK_ID"
        BRANCH_NAME="wmux/subtask-$TASK_ID"
        mkdir -p "$REPO_ROOT/.wmux/worktrees"

        echo "[wmux-subagent] Creating git worktree at $WORKTREE_DIR (branch: $BRANCH_NAME)..."
        if ! git -C "$REPO_ROOT" worktree add -b "$BRANCH_NAME" "$WORKTREE_DIR" HEAD >/dev/null 2>&1; then
            echo "Error: Failed to create git worktree." >&2
            exit 1
        fi
        TARGET_DIR="$WORKTREE_DIR"
        CLEANUP_WORKTREE_DIR="$WORKTREE_DIR"
        CLEANUP_REPO_ROOT="$REPO_ROOT"
        CLEANUP_BRANCH_NAME="$BRANCH_NAME"
    fi

    # Create coordination state directory (0700 owner-only)
    local STATE_DIR
    STATE_DIR="$(mktemp -d -t "wmux-subagent-${TASK_ID}.XXXXXX")"
    chmod 0700 "$STATE_DIR"
    CLEANUP_STATE_DIR="$STATE_DIR"

    local OUTPUT_FILE="$STATE_DIR/output.log"
    local STATUS_FILE="$STATE_DIR/status"
    local DONE_FILE="$STATE_DIR/done"
    local PROMPT_FILE="$STATE_DIR/prompt.txt"
    local RUNNER_SCRIPT="$STATE_DIR/runner.sh"
    local SURFACE_FILE="$STATE_DIR/surface_id"
    local WORKSPACE_FILE="$STATE_DIR/workspace_id"

    # Status Bar integration: task status JSON in ~/.config/cmux/subagents
    mkdir -p "$SUBAGENTS_DIR"
    STATUS_JSON="$SUBAGENTS_DIR/${TASK_ID}.json"
    CLEANUP_STATUS_JSON="$STATUS_JSON"
    START_TIME="$(date +%s)"

    # Write prompt
    printf '%s' "$PROMPT" > "$PROMPT_FILE"

    # Generate pane runner script
    cat << EOF > "$RUNNER_SCRIPT"
#!/usr/bin/env bash
# Auto-generated by wmux-subagent for task: $TASK_ID

STATE_DIR=$(printf '%q' "$STATE_DIR")
TARGET_DIR=$(printf '%q' "$TARGET_DIR")
TITLE=$(printf '%q' "$TITLE")
TASK_ID=$(printf '%q' "$TASK_ID")
AGY_BIN=$(printf '%q' "$AGY_BIN")
CMUX_BIN=$(printf '%q' "$CMUX_BIN")
CMUX_SOCKET_PATH=$(printf '%q' "${CMUX_SOCKET_PATH:-}")
STATUS_JSON=$(printf '%q' "$STATUS_JSON")
START_TIME=$(printf '%q' "$START_TIME")
ACCOUNT_ID=$(printf '%q' "${ACCOUNT:-}")
WAIT=$(printf '%q' "$WAIT")

cleanup_runner() {
    if [[ -n "\$STATUS_JSON" && -f "\$STATUS_JSON" ]]; then
        rm -f "\$STATUS_JSON"
    fi
    exit 130
}
trap cleanup_runner INT TERM HUP

cd "\$TARGET_DIR" || {
    echo "Error: Failed to cd to \$TARGET_DIR" >&2
    echo "1" > "\$STATE_DIR/status"
    touch "\$STATE_DIR/done"
    exit 1
}

printf '\033[1;36m%s\033[0m\n' "============================================================"
printf '\033[1;36m  wmux Subagent: %s\033[0m\n' "\$TITLE"
printf '\033[0;33m  Task ID:   \033[0m%s\n' "\$TASK_ID"
printf '\033[0;33m  Directory: \033[0m%s\n' "\$TARGET_DIR"
if [[ -n "\${CMUX_SURFACE_ID:-}" ]]; then
    printf '\033[0;33m  Surface:   \033[0m%s\n' "\$CMUX_SURFACE_ID"
fi
if [[ -n "\${CMUX_AGY_ISOLATED_ACCOUNT:-}" ]]; then
    printf '\033[0;33m  Account:   \033[0m%s\n' "\$CMUX_AGY_ISOLATED_ACCOUNT"
fi
printf '\033[1;36m%s\033[0m\n\n' "============================================================"

STREAMER_PY="\$STATE_DIR/streamer.py"
cat << 'STREAMER_EOF' > "\$STREAMER_PY"
import sys, json

output_log = sys.argv[1] if len(sys.argv) > 1 else None
final_response = []
raw_lines = []

try:
    sys.stdin.reconfigure(encoding="utf-8", errors="replace")
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")
except Exception:
    pass

def clean_arg(s, max_len=65):
    s = str(s).replace("\n", " ").strip()
    return (s[:max_len] + "...") if len(s) > max_len else s

def format_tool(name, params):
    if not isinstance(params, dict):
        return ""
    if name == "run_command":
        cmd = params.get("CommandLine", "")
        return clean_arg(cmd, 70)
    if name in ("read_file", "view_file", "edit_file", "write_file", "replace_file_content"):
        path = str(params.get("Path", params.get("path", "")))
        parts = path.split("/")
        return "/".join(parts[-3:]) if len(parts) > 3 else path
    for k in ("query", "pattern", "symbol", "name"):
        if k in params:
            return f"{k}={clean_arg(params[k], 40)}"
    return ""

sys.stdout.write("\033[1;34m⚡ Starting Subagent Execution (Live Stream)...\033[0m\n\n")
sys.stdout.flush()

for line in sys.stdin:
    raw_lines.append(line)
    line_str = line.strip()
    if not line_str:
        continue
    try:
        data = json.loads(line_str)
    except Exception:
        sys.stdout.write(line_str + "\n")
        sys.stdout.flush()
        continue

    event = data.get("event")
    if event == "step_update":
        step = data.get("step_update", {})
        stype = step.get("step_type")
        state = step.get("state")
        
        if stype == "tool":
            tname = step.get("tool_name") or step.get("tool_info", {}).get("name", "tool")
            if state == "ACTIVE":
                params = step.get("tool_info", {}).get("parameters", {})
                detail = format_tool(tname, params)
                sys.stdout.write(f"\033[1;33m● [Tool]\033[0m \033[1m{tname}\033[0m {detail}\n")
                sys.stdout.flush()
            elif state == "DONE":
                dur = step.get("duration_seconds")
                dur_str = f" ({dur:.1f}s)" if dur else ""
                sys.stdout.write(f"\033[1;32m✔ [Done]\033[0m{dur_str}\n")
                sys.stdout.flush()
        elif stype == "agent_response":
            delta = step.get("text_delta", "")
            if delta:
                sys.stdout.write(delta)
                sys.stdout.flush()
    elif event == "result":
        resp = data.get("result", {}).get("response", "")
        if resp:
            final_response = [resp]
            sys.stdout.write("\n\n\033[1;32m★ [Subagent Task Completed]\033[0m\n")
            sys.stdout.flush()

if output_log:
    try:
        with open(output_log, "w", encoding="utf-8") as f:
            if final_response:
                f.write(final_response[0])
            elif raw_lines:
                f.write("".join(raw_lines))
    except Exception:
        pass
STREAMER_EOF

PROMPT="\$(cat "\$STATE_DIR/prompt.txt")"

SUBAGENT_EXIT=0
if command -v python3 >/dev/null 2>&1; then
    "\$AGY_BIN" -p "\$PROMPT" --dangerously-skip-permissions --output-format stream-json 2>&1 | python3 "\$STREAMER_PY" "\$STATE_DIR/output.log"
    SUBAGENT_EXIT="\${PIPESTATUS[0]}"
else
    "\$AGY_BIN" -p "\$PROMPT" --dangerously-skip-permissions 2>&1 | tee "\$STATE_DIR/output.log"
    SUBAGENT_EXIT="\${PIPESTATUS[0]}"
fi

echo "\$SUBAGENT_EXIT" > "\$STATE_DIR/status"
touch "\$STATE_DIR/done"

# Generate Subagent Conclusion Report in .wmux/reports/<task_id>.md
REPORT_ROOT="\$TARGET_DIR"
if command -v git >/dev/null 2>&1; then
    COMMON_GIT_DIR="\$(git -C "\$TARGET_DIR" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
    if [[ -n "\$COMMON_GIT_DIR" && -d "\$COMMON_GIT_DIR" ]]; then
        REPORT_ROOT="\$(cd "\$COMMON_GIT_DIR/.." && pwd)"
    elif git -C "\$TARGET_DIR" rev-parse --show-toplevel >/dev/null 2>&1; then
        REPORT_ROOT="\$(git -C "\$TARGET_DIR" rev-parse --show-toplevel)"
    fi
fi
REPORT_DIR="\$REPORT_ROOT/.wmux/reports"
mkdir -p "\$REPORT_DIR"
REPORT_FILE="\$REPORT_DIR/\${TASK_ID}.md"
LATEST_REPORT="\$REPORT_DIR/latest.md"

END_TIME="\$(date +%s)"
DURATION=\$(( END_TIME - START_TIME ))
START_DATE="\$(date -r "\$START_TIME" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || date '+%Y-%m-%d %H:%M:%S')"

STATUS_LABEL="Completed (Exit 0)"
if [[ "\$SUBAGENT_EXIT" -ne 0 ]]; then
    STATUS_LABEL="Failed (Exit \$SUBAGENT_EXIT)"
fi

GIT_SUMMARY=""
if command -v git >/dev/null 2>&1 && git -C "\$TARGET_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    GIT_SUMMARY="\$(git -C "\$TARGET_DIR" status --short 2>/dev/null || true)"
fi

cat << REPORT_EOF > "\$REPORT_FILE"
# Subagent Task Report: \$TITLE

| Attribute | Details |
| :--- | :--- |
| **Task ID** | \`\$TASK_ID\` |
| **Status** | **\$STATUS_LABEL** |
| **Account** | \`\${ACCOUNT_ID:-pool}\` |
| **Duration** | \`\${DURATION}s\` |
| **Started** | \`\$START_DATE\` |
| **Directory** | \`\$TARGET_DIR\` |
| **Surface** | \`\${CMUX_SURFACE_ID:-unknown}\` |

## Instructions / Prompt
> \$(cat "\$STATE_DIR/prompt.txt" 2>/dev/null || echo "\$PROMPT")

## Execution Summary & Conclusion
\$(cat "\$STATE_DIR/output.log" 2>/dev/null || echo "(No output generated)")

REPORT_EOF

if [[ -n "\$GIT_SUMMARY" ]]; then
    cat << REPORT_EOF >> "\$REPORT_FILE"

## Modified Files
\`\`\`text
\$GIT_SUMMARY
\`\`\`
REPORT_EOF
fi

cp "\$REPORT_FILE" "\$LATEST_REPORT"

printf '\n\033[1;32m%s\033[0m\n' "============================================================"
printf '\033[1;32m  ✔ wmux Subagent [%s] completed (Status: %d)\033[0m\n' "\$TITLE" "\$SUBAGENT_EXIT"
printf '\033[0;33m  Account:   \033[0m%s\n' "\${ACCOUNT_ID:-pool}"
printf '\033[0;32m  Report:    \033[0m%s\n' "\$REPORT_FILE"
printf '\033[0;36m  Execution logs and diffs are preserved above for inspection.\033[0m\n'
printf '\033[0;37m  Type \033[1mexit\033[0m\033[0;37m or press \033[1mCtrl+D\033[0m\033[0;37m to close this pane when finished.\033[0m\n'
printf '\033[1;32m%s\033[0m\n\n' "============================================================"

ACTIVE_SURFACE="\${CMUX_SURFACE_ID:-}"
if [[ -z "\$ACTIVE_SURFACE" && -f "\$STATE_DIR/surface_id" ]]; then
    ACTIVE_SURFACE="\$(cat "\$STATE_DIR/surface_id" 2>/dev/null || true)"
fi
ACTIVE_WORKSPACE="\${CMUX_WORKSPACE_ID:-}"
if [[ -z "\$ACTIVE_WORKSPACE" && -f "\$STATE_DIR/workspace_id" ]]; then
    ACTIVE_WORKSPACE="\$(cat "\$STATE_DIR/workspace_id" 2>/dev/null || true)"
fi

# Update Subagent Status Bar file to done (persists for user visibility until pane is closed)
if [[ -f "\$STATUS_JSON" ]]; then
    if command -v python3 >/dev/null 2>&1; then
        python3 -c '
import json, sys
data = {
    "id": sys.argv[1],
    "title": sys.argv[2],
    "account": sys.argv[3],
    "surface_id": sys.argv[4],
    "status": "done",
    "start_time": int(sys.argv[5])
}
with open(sys.argv[6], "w") as f:
    json.dump(data, f, indent=2)
' "\$TASK_ID" "\$TITLE" "\${ACCOUNT_ID:-pool}" "\${ACTIVE_SURFACE:-}" "\$START_TIME" "\$STATUS_JSON" 2>/dev/null || true
    fi
fi

# Note: Preserving pane open by default so user can inspect output and worktree changes.
# Pane will close naturally when the user enters 'exit' or closes the split.
# In wait mode ($WAIT == 1), parent wmux-subagent run will clean up $STATE_DIR after reading outputs.
if [[ "\$WAIT" == "0" && -z "\${WMUX_DEBUG:-}" && -d "\$STATE_DIR" ]]; then
    rm -rf "\$STATE_DIR"
fi

exit \$SUBAGENT_EXIT
EOF

    chmod +x "$RUNNER_SCRIPT"

    # Command to run inside the new pane
    local PANE_COMMAND="bash $(printf '%q' "$RUNNER_SCRIPT")"

    # Layout Engine: Query existing subagent surfaces in the current workspace
    # Adheres to the Master-Slave / Elastic Grid Blueprint (1-5 visual splits, 6+ tabbed)
    local ACTIVE_SUBAGENT_SURFACES=()
    if [[ -d "$SUBAGENTS_DIR" ]]; then
        local CURRENT_PANELS=""
        CURRENT_PANELS="$(cmux_invoke list-panels 2>/dev/null || true)"
        # Read subagent status files sorted by start_time
        while IFS= read -r sf; do
            [[ -f "$sf" ]] || continue
            local sid=""
            sid="$(python3 -c '
import json, sys
try:
    with open(sys.argv[1]) as f:
        d = json.load(f)
    print(d.get("surface_id") or "")
except Exception:
    pass
' "$sf" 2>/dev/null || true)"
            if [[ -n "$sid" ]] && printf '%s\n' "$CURRENT_PANELS" | grep -q "$sid"; then
                ACTIVE_SUBAGENT_SURFACES+=("$sid")
            fi
        done < <(find "$SUBAGENTS_DIR" -name "*.json" -type f -exec grep -l '"surface_id"' {} + 2>/dev/null || true)
    fi

    local SUBAGENT_COUNT=${#ACTIVE_SUBAGENT_SURFACES[@]}

    # Pane creation based on current subagent count:
    # 0 -> new-split right from master (creates master 60% : slave 40%)
    # 1 -> new-split down from S0 (creates 2 vertical rows)
    # 2 -> new-split down from S1 (creates 3 vertical rows)
    # 3 -> new-split right from S0 (turns into 2x2 grid in auxiliary area)
    # 4 -> new-split right from S1 (turns into 'top 2, bottom 3' grid)
    # 5+ -> new-surface inside existing subagent pane (tabbed mode to prevent vertical crush)
    local SPLIT_OUTPUT=""
    local SPLIT_ERR=""

    if (( SUBAGENT_COUNT == 0 )); then
        SPLIT_OUTPUT="$(cmux_invoke --json --id-format both new-split right --command "$PANE_COMMAND" 2>&1)" || true
    elif (( SUBAGENT_COUNT == 1 )); then
        local anchor="${ACTIVE_SUBAGENT_SURFACES[0]}"
        SPLIT_OUTPUT="$(cmux_invoke --json --id-format both new-split down --surface "$anchor" --command "$PANE_COMMAND" 2>&1)" || true
    elif (( SUBAGENT_COUNT == 2 )); then
        local anchor="${ACTIVE_SUBAGENT_SURFACES[1]}"
        SPLIT_OUTPUT="$(cmux_invoke --json --id-format both new-split down --surface "$anchor" --command "$PANE_COMMAND" 2>&1)" || true
    elif (( SUBAGENT_COUNT == 3 )); then
        local anchor="${ACTIVE_SUBAGENT_SURFACES[0]}"
        SPLIT_OUTPUT="$(cmux_invoke --json --id-format both new-split right --surface "$anchor" --command "$PANE_COMMAND" 2>&1)" || true
    elif (( SUBAGENT_COUNT == 4 )); then
        local anchor="${ACTIVE_SUBAGENT_SURFACES[1]}"
        SPLIT_OUTPUT="$(cmux_invoke --json --id-format both new-split right --surface "$anchor" --command "$PANE_COMMAND" 2>&1)" || true
    else
        # 5 or more existing subagents: use surface tabs in the right column
        local anchor="${ACTIVE_SUBAGENT_SURFACES[-1]}"
        SPLIT_OUTPUT="$(cmux_invoke --json --id-format both new-split down --surface "$anchor" --command "$PANE_COMMAND" 2>&1)" || true
    fi

    # Fallback to simple split if targeted split failed
    if [[ -z "$SPLIT_OUTPUT" ]] || ! extract_surface_uuid "$SPLIT_OUTPUT" >/dev/null 2>&1; then
        if ! SPLIT_OUTPUT="$(cmux_invoke --json --id-format both new-split right --command "$PANE_COMMAND" 2>&1)"; then
            SPLIT_ERR="$SPLIT_OUTPUT"
            echo "Error: Failed to split surface pane:" >&2
            echo "$SPLIT_ERR" >&2
            if [[ "$WORKTREE" == "1" && -d "$WORKTREE_DIR" ]]; then
                git -C "$REPO_ROOT" worktree remove --force "$WORKTREE_DIR" >/dev/null 2>&1 || true
                git -C "$REPO_ROOT" branch -D "$BRANCH_NAME" >/dev/null 2>&1 || true
            fi
            rm -f "$STATUS_JSON"
            exit 1
        fi
    fi

    local SUBAGENT_SURFACE_UUID
    local SUBAGENT_SURFACE_REF
    local SUBAGENT_WORKSPACE_ID
    SUBAGENT_SURFACE_UUID="$(extract_surface_uuid "$SPLIT_OUTPUT")"
    SUBAGENT_SURFACE_REF="$(extract_surface_ref "$SPLIT_OUTPUT")"
    SUBAGENT_WORKSPACE_ID="$(extract_workspace_ref "$SPLIT_OUTPUT")"

    local TARGET_SURFACE="${SUBAGENT_SURFACE_REF:-$SUBAGENT_SURFACE_UUID}"
    local PERSISTENT_SURFACE="${SUBAGENT_SURFACE_UUID:-$TARGET_SURFACE}"
    local TARGET_PANE
    TARGET_PANE="$(extract_pane_ref "$SPLIT_OUTPUT")"
    if [[ -n "$TARGET_SURFACE" ]]; then
        echo "$PERSISTENT_SURFACE" > "$SURFACE_FILE"
        # Rename the new tab / pane for clear visibility
        cmux_invoke tab-action --action rename --title "Subagent: $TITLE" --surface "$TARGET_SURFACE" >/dev/null 2>&1 || true
    fi

    # When creating the first subagent, resize right pane so Master occupies ~40% and Subagents occupy ~60%
    if (( SUBAGENT_COUNT == 0 )) && [[ -n "$TARGET_PANE" ]]; then
        cmux_invoke resize-pane --pane "$TARGET_PANE" -L --amount 18 >/dev/null 2>&1 || true
    fi
    if [[ -n "$SUBAGENT_WORKSPACE_ID" ]]; then
        echo "$SUBAGENT_WORKSPACE_ID" > "$WORKSPACE_FILE"
    fi

    # Resolve account ID using child surface UUID
    local ACCOUNT_ID
    ACCOUNT_ID="$(resolve_account_id "$ACCOUNT" "$SUBAGENT_SURFACE_UUID")"

    # Register running task in Status Bar with accurate child account and persistent surface UUID
    write_status_json "$STATUS_JSON" "$TASK_ID" "$TITLE" "$ACCOUNT_ID" "$PERSISTENT_SURFACE" "running" "$START_TIME"

    # Handle completion / waiting
    if [[ "$WAIT" == "1" ]]; then
        local wait_count=0
        # Wait for subagent runner to complete with watchdog
        while [[ ! -f "$DONE_FILE" ]]; do
            sleep 0.5
            (( wait_count++ ))
            # After grace period (5s), verify target surface still exists in cmux
            if (( wait_count > 10 )) && (( wait_count % 6 == 0 )) && [[ -n "$TARGET_SURFACE" ]]; then
                if ! cmux_invoke list-panels --id-format both 2>/dev/null | grep -q "$TARGET_SURFACE"; then
                    echo "[wmux-subagent] Notice: Subagent surface $TARGET_SURFACE is no longer active." >&2
                    break
                fi
            fi
        done

        local EXIT_CODE=0
        if [[ -f "$STATUS_FILE" ]]; then
            EXIT_CODE="$(cat "$STATUS_FILE" | tr -d '[:space:]')"
        fi

        # Retrieve and output subagent log
        if [[ -f "$OUTPUT_FILE" ]]; then
            cat "$OUTPUT_FILE"
        fi

        # Update status to done for UI status bar
        if [[ -f "$STATUS_JSON" ]]; then
            write_status_json "$STATUS_JSON" "$TASK_ID" "$TITLE" "$ACCOUNT_ID" "$TARGET_SURFACE" "done" "$START_TIME"
        fi

        # Note: Pane is preserved open for inspection and manual closure

        local REPORT_ROOT="$TARGET_DIR"
        if command -v git >/dev/null 2>&1; then
            local COMMON_GIT_DIR
            COMMON_GIT_DIR="$(git -C "$TARGET_DIR" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
            if [[ -n "$COMMON_GIT_DIR" && -d "$COMMON_GIT_DIR" ]]; then
                REPORT_ROOT="$(cd "$COMMON_GIT_DIR/.." && pwd)"
            elif git -C "$TARGET_DIR" rev-parse --show-toplevel >/dev/null 2>&1; then
                REPORT_ROOT="$(git -C "$TARGET_DIR" rev-parse --show-toplevel)"
            fi
        fi
        local REPORT_FILE="$REPORT_ROOT/.wmux/reports/${TASK_ID}.md"
        if [[ -f "$REPORT_FILE" ]]; then
            echo ""
            echo "============================================================"
            echo "[wmux-subagent] Report saved to: $REPORT_FILE"
            echo "============================================================"
        fi

        # If worktree was used, report commits and review/merge instructions
        if [[ "$WORKTREE" == "1" ]]; then
            echo ""
            echo "============================================================"
            echo "Subagent git worktree ready for review:"
            echo "  Worktree path: $WORKTREE_DIR"
            echo "  Branch:        $BRANCH_NAME"

            local COMMITS
            COMMITS="$(git -C "$REPO_ROOT" log --oneline "HEAD..$BRANCH_NAME" 2>/dev/null || true)"
            if [[ -n "$COMMITS" ]]; then
                echo ""
                echo "Commits created on $BRANCH_NAME:"
                echo "$COMMITS"
                echo ""
                echo "To review changes:"
                echo "  git diff HEAD..$BRANCH_NAME"
                echo "To merge into current branch:"
                echo "  git merge $BRANCH_NAME"
            else
                local DIFF_STAT
                DIFF_STAT="$(git -C "$WORKTREE_DIR" status --short 2>/dev/null || true)"
                if [[ -n "$DIFF_STAT" ]]; then
                    echo ""
                    echo "Uncommitted changes in worktree:"
                    echo "$DIFF_STAT"
                else
                    echo ""
                    echo "No commits or changes were made in the worktree."
                fi
            fi
            echo ""
            echo "To remove the worktree when finished:"
            echo "  git worktree remove \"$WORKTREE_DIR\""
            echo "============================================================"
        fi

        exit "${EXIT_CODE:-0}"
    else
        echo "[wmux-subagent] Subagent pane launched successfully."
        echo "  Task ID:  $TASK_ID"
        echo "  Title:    $TITLE"
        echo "  Account:  $ACCOUNT_ID"
        if [[ -n "${SUBAGENT_SURFACE_ID:-}" ]]; then
            echo "  Surface:  $SUBAGENT_SURFACE_ID"
        fi
        echo "  Report:   .wmux/reports/${TASK_ID}.md (auto-generated upon completion)"
        echo "  Inspect:  wmux-subagent report --latest"
        if [[ "$WORKTREE" == "1" ]]; then
            echo "  Worktree: $WORKTREE_DIR"
            echo "  Branch:   $BRANCH_NAME"
            echo ""
            echo "To inspect or merge when complete:"
            echo "  git log HEAD..$BRANCH_NAME"
            echo "  git merge $BRANCH_NAME"
            echo "To clean up worktree:"
            echo "  git worktree remove \"$WORKTREE_DIR\""
        fi
        exit 0
    fi
}

cmd_report() {
    local TARGET_ARG="${1:-}"
    local REPO_ROOT=""
    if command -v git >/dev/null 2>&1; then
        local COMMON_GIT_DIR
        COMMON_GIT_DIR="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
        if [[ -n "$COMMON_GIT_DIR" && -d "$COMMON_GIT_DIR" ]]; then
            REPO_ROOT="$(cd "$COMMON_GIT_DIR/.." && pwd)"
        elif git rev-parse --show-toplevel >/dev/null 2>&1; then
            REPO_ROOT="$(git rev-parse --show-toplevel)"
        fi
    fi
    if [[ -z "$REPO_ROOT" ]]; then
        REPO_ROOT="$PWD"
    fi
    local REPORT_DIR="$REPO_ROOT/.wmux/reports"

    if [[ ! -d "$REPORT_DIR" ]]; then
        if [[ "$TARGET_ARG" == "--list" || -z "$TARGET_ARG" ]]; then
            echo "No subagent reports found in $REPORT_DIR yet."
            echo "Reports are automatically generated under .wmux/reports/ when tasks complete."
            return 0
        else
            echo "No subagent reports directory found in $REPORT_DIR" >&2
            return 1
        fi
    fi

    case "$TARGET_ARG" in
        --latest|-l)
            if [[ -f "$REPORT_DIR/latest.md" ]]; then
                cat "$REPORT_DIR/latest.md"
            else
                local newest
                newest="$(ls -t "$REPORT_DIR"/*.md 2>/dev/null | grep -v 'latest.md' | head -n 1 || true)"
                if [[ -n "$newest" && -f "$newest" ]]; then
                    cat "$newest"
                else
                    echo "No subagent reports available in $REPORT_DIR" >&2
                    return 1
                fi
            fi
            ;;
        --list|"")
            echo "Available Subagent Reports in $REPORT_DIR:"
            echo "================================================================================"
            printf '%-28s | %-12s | %-20s | %s\n' "Task ID" "Status" "Date" "Title"
            echo "--------------------------------------------------------------------------------"
            local found=0
            for rf in "$REPORT_DIR"/*.md; do
                [[ -f "$rf" ]] || continue
                local bn
                bn="$(basename "$rf" .md)"
                [[ "$bn" == "latest" ]] && continue
                found=1

                local title status rdate
                title="$(grep -m 1 '^# Subagent Task Report:' "$rf" | sed 's/# Subagent Task Report:[[:space:]]*//' || echo "$bn")"
                status="$(grep -m 1 '\*\*Status\*\*' "$rf" | sed -E 's/.*\*\*(Completed|Failed)[^*]*\*\*.*/\1/' || echo "Done")"
                rdate="$(grep -m 1 '\*\*Started\*\*' "$rf" | sed -E 's/.*\*\*[[:space:]]*`([^`]+)`.*/\1/' || echo "-")"
                printf '%-28s | %-12s | %-20s | %s\n' "$bn" "$status" "$rdate" "$title"
            done
            if [[ "$found" == "0" ]]; then
                echo "  (No reports generated yet)"
            fi
            echo "================================================================================"
            echo "View specific report: wmux-subagent report <task-id> | --latest"
            ;;
        *)
            local safe_arg
            safe_arg="$(basename "$TARGET_ARG")"
            if [[ ! "$safe_arg" =~ ^[a-zA-Z0-9_.-]+$ ]] || [[ "$safe_arg" == "." || "$safe_arg" == ".." ]]; then
                echo "Error: Invalid report identifier '$TARGET_ARG'. Must be alphanumeric with hyphen/underscore/dot only." >&2
                return 1
            fi

            local target="$REPORT_DIR/${safe_arg}.md"
            if [[ ! -f "$target" && -f "$REPORT_DIR/$safe_arg" && "$safe_arg" == *.md ]]; then
                target="$REPORT_DIR/$safe_arg"
            fi

            if [[ -L "$target" ]]; then
                echo "Error: Symlink reports are not permitted." >&2
                return 1
            fi

            if [[ -f "$target" ]]; then
                # Security: Canonical directory and symlink traversal verification
                local real_target real_dir
                real_target="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$target" 2>/dev/null || true)"
                real_dir="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$REPORT_DIR" 2>/dev/null || true)"
                if [[ -n "$real_target" && -n "$real_dir" && "$real_target" == "$real_dir/"* && -f "$real_target" && ! -L "$target" ]]; then
                    cat "$real_target"
                else
                    echo "Error: Path traversal attempt rejected." >&2
                    return 1
                fi
            else
                echo "Error: Report '$safe_arg' not found in $REPORT_DIR" >&2
                return 1
            fi
            ;;
    esac
}

main() {
    if [[ $# -eq 0 ]]; then
        show_help
        exit 0
    fi

    local SUBCOMMAND="$1"
    shift

    case "$SUBCOMMAND" in
        run)
            cmd_run "$@"
            ;;
        report|reports)
            cmd_report "$@"
            ;;
        help|-h|--help)
            show_help
            exit 0
            ;;
        *)
            echo "Error: Unknown subcommand '$SUBCOMMAND'. Use --help for usage." >&2
            exit 1
            ;;
    esac
}

main "$@"
